{
	# Локально наружу проброшен только 8443; редиректа с :80 нет.
	auto_https disable_redirects
}

# Access-логи не включаем (директивы log нет): токены /join/... и /a/... не должны попадать в логи.
localhost {
	tls internal
	# Не выдаём стек: ни Server (Caddy/uvicorn), ни Via от прокси.
	header {
		-Server
		-Via
		defer
	}

	reverse_proxy app:8000
}
