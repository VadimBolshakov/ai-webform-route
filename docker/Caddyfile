{
	# Locally only 8443 is published; there is no redirect from :80.
	auto_https disable_redirects
}

# Access logs are not enabled (no log directive): /join/... and /a/... tokens must not end up in logs.
localhost {
	tls internal
	# Do not reveal the stack: no Server (Caddy/uvicorn) and no Via from the proxy.
	header {
		-Server
		-Via
		defer
	}

	reverse_proxy app:8000
}
