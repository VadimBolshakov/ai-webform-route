{
	# Email for Let's Encrypt (certificate problem notifications).
	email {$ACME_EMAIL}
}

# Access logs are not enabled (no log directive): /a/... and /join/... tokens must not end up in logs.
{$DOMAIN} {
	# /healthz is only for checking the container from inside; from outside we serve the app's ordinary neutral 404
	# so as not to reveal the purpose of the site.
	@health path /healthz
	rewrite @health /__not_found

	# Upper bound on the request body (the app cuts more precisely itself: 64 KB everywhere except message sending).
	request_body {
		max_size 60MB
	}

	# Do not reveal the stack: no Server (Caddy/uvicorn) and no Via from the proxy.
	header {
		-Server
		-Via
		defer
	}

	reverse_proxy app:8000
}
