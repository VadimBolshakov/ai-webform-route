{
	# Почта для Let's Encrypt (уведомления о проблемах с сертификатом).
	email {$ACME_EMAIL}
}

# Access-логи не включаем (директивы log нет): токены /a/... и /join/... не должны попадать в логи.
{$DOMAIN} {
	# /healthz нужен только для проверки контейнера изнутри; снаружи отдаём обычный нейтральный 404
	# приложения, чтобы не выдавать назначение сайта.
	@health path /healthz
	rewrite @health /__not_found

	# Верхняя граница тела запроса (приложение само режет точнее: 64 КБ везде, кроме отправки сообщений).
	request_body {
		max_size 60MB
	}

	# Не выдаём стек: ни Server (Caddy/uvicorn), ни Via от прокси.
	header {
		-Server
		-Via
		defer
	}

	reverse_proxy app:8000
}
