# Every night at 03:30 server time (plus a random delay of up to 10 minutes).
# Persistent=true: a run missed because the server was off is executed after boot.
[Unit]
Description=AI Chat: nightly database backup at 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
