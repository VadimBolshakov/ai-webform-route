# Каждую ночь в 03:30 по времени сервера (плюс случайная задержка до 10 минут).
# Persistent=true: запуск, пропущенный из-за выключенного сервера, выполняется после загрузки.
[Unit]
Description=AI Chat: ночной бэкап базы в 03:30

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
