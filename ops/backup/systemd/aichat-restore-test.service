# Monthly restore check (ops/backup/restore-test.sh). Started by the timer
# aichat-restore-test.timer; manually: sudo systemctl start aichat-restore-test.service
[Unit]
Description=AI Chat: backup restore check into a temporary database
Wants=network-online.target
# After=aichat-backup.service: if both runs are queued (catching up after boot),
# the check waits for the backup to finish.
After=network-online.target docker.service aichat-backup.service

[Service]
Type=oneshot
ExecStart=/opt/aichat/ops/backup/restore-test.sh
User=root
# Project working directory: /opt/aichat/.env sets a relative COMPOSE_FILE
# (docker-compose.yml:docker-compose.prod.yml), and docker compose resolves it from the current directory.
WorkingDirectory=/opt/aichat
TimeoutStartSec=2h
# Default KillMode (control-group); 90 s is enough for restore-test.sh to drop the temporary
# database, write the status and send the /fail ping.
TimeoutStopSec=90s
# The whole file system is read-only except the directories below. The docker CLI still works:
# connecting to /run/docker.sock is not a file system write, volumes (-v) are mounted by dockerd,
# docker writes nothing to $HOME (/root, set by systemd from User=). Verified on Ubuntu 24.04.
ProtectSystem=strict
# /var/lib/aichat-backup (status) and /var/cache/aichat-restic (restic cache): systemd creates them before
# start if they are missing (e.g. the cache was deleted) and makes them writable.
StateDirectory=aichat-backup
StateDirectoryMode=0700
CacheDirectory=aichat-restic
CacheDirectoryMode=0700
PrivateTmp=true
NoNewPrivileges=true
