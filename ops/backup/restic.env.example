# Template for /etc/aichat/restic.env - owner root:root, mode 600. Do not put in git: all values are secrets.
# Format: KEY=VALUE without quotes or spaces (the file is read by both docker --env-file and bash).
# The repository password is stored separately, in /etc/aichat/restic-password (created by init-repo.sh).

# restic repository in S3: s3:s3.eu-central-1.amazonaws.com/<bucket name>/aichat
RESTIC_REPOSITORY=
# Access key of the server's IAM user (programmatic access only, policy ops/backup/aws/iam-policy.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket region: eu-central-1
AWS_DEFAULT_REGION=
# Liveness-ping service: healthchecks (default) or cronitor
PING_STYLE=
# Ping URL of the aichat-backup check; empty - pings are skipped.
#   healthchecks.io: https://hc-ping.com/<uuid>
#   Cronitor:        https://cronitor.link/p/<telemetry key>/aichat-backup
HC_BACKUP_URL=
# Ping URL of the aichat-restore-test check (same format); empty - pings are skipped
HC_RESTORE_URL=
