# Шаблон /etc/aichat/restic.env — владелец root:root, права 600. В git не класть: все значения — секреты.
# Формат: KEY=VALUE без кавычек и пробелов (файл читают и docker --env-file, и bash).
# Пароль репозитория хранится отдельно, в /etc/aichat/restic-password (его создаёт init-repo.sh).

# Репозиторий restic в S3: s3:s3.eu-central-1.amazonaws.com/<имя бакета>/aichat
RESTIC_REPOSITORY=
# Ключ IAM-пользователя сервера (только программный доступ, политика ops/backup/aws/iam-policy.json)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Регион бакета: eu-central-1
AWS_DEFAULT_REGION=
# URL проверки aichat-backup на healthchecks.io (https://hc-ping.com/<uuid>); пусто — пинги пропускаются
HC_BACKUP_URL=
# URL проверки aichat-restore-test на healthchecks.io; пусто — пинги пропускаются
HC_RESTORE_URL=
