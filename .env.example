# Скопируйте в .env и заполните. Реальные секреты не коммитить.
# Строка подключения к PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://aichat:aichat@db:5432/aichat
# Ключ Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Ключ API OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Секретный токен в пути входа /a/{LOGIN_PATH_TOKEN}
LOGIN_PATH_TOKEN=
# Публичный базовый URL сайта (проверка Origin, ссылки): только https://host[:port], без пути;
# http допустим лишь для localhost
BASE_URL=https://localhost:8443
# Срок сессии, дней
SESSION_TTL_DAYS=7
# Месячный лимит по умолчанию, USD
DEFAULT_MONTHLY_LIMIT_USD=5
# Лимит запросов чата в минуту на пользователя
CHAT_RATE_PER_MIN=20
# Бюджет токенов контекста (системный промпт + новое сообщение с вложениями должны в него влезать)
CONTEXT_TOKEN_BUDGET=24000
# Максимум токенов ответа модели (max_tokens в запросе)
MAX_OUTPUT_TOKENS=4096
# Модель для генерации заголовков чатов (не пустая)
TITLE_MODEL=openai/gpt-4o-mini
# Модели, из которых может выбирать Auto (openrouter/auto), JSON-список шаблонов.
# Пусто = Auto может выбрать ЛЮБУЮ модель, в т.ч. дорогую. Рекомендуется задать, например:
# AUTO_ALLOWED_MODELS=["openai/gpt-4o-mini","anthropic/claude-haiku-*","google/gemini-*-flash*"]
AUTO_ALLOWED_MODELS=[]
# Макс. размер вложения, МБ
MAX_UPLOAD_MB=10
# Фоновые задачи (false в тестах)
ENABLE_JOBS=true
# Пароль Postgres для docker-compose (сервис db)
POSTGRES_PASSWORD=aichat
# Порт Postgres на хосте (если 5432 занят)
DB_HOST_PORT=5432
