# Copy to .env and fill in. Never commit real secrets.
# PostgreSQL connection string (asyncpg)
DATABASE_URL=postgresql+asyncpg://aichat:aichat@db:5432/aichat
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# OpenRouter API key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Secret token in the login path /a/{LOGIN_PATH_TOKEN}
LOGIN_PATH_TOKEN=
# Public base URL of the site (Origin check, links): only https://host[:port], no path;
# http is allowed only for localhost
BASE_URL=https://localhost:8443
# Session lifetime, days
SESSION_TTL_DAYS=7
# Default monthly limit, USD
DEFAULT_MONTHLY_LIMIT_USD=5
# Chat requests per minute per user
CHAT_RATE_PER_MIN=20
# Context token budget (system prompt + new message with attachments must fit in it)
CONTEXT_TOKEN_BUDGET=24000
# Maximum model response tokens (max_tokens in the request)
MAX_OUTPUT_TOKENS=4096
# Model for generating chat titles (must not be empty)
TITLE_MODEL=openai/gpt-4o-mini
# Models Auto (openrouter/auto) may choose from, a JSON list of patterns.
# Empty = Auto may pick ANY model, including expensive ones. Recommended to set, for example:
# AUTO_ALLOWED_MODELS=["openai/gpt-4o-mini","anthropic/claude-haiku-*","google/gemini-*-flash*"]
AUTO_ALLOWED_MODELS=[]
# Max attachment size, MB
MAX_UPLOAD_MB=10
# Background jobs (false in tests)
ENABLE_JOBS=true
# Telegram owner bot (optional). Create a bot via @BotFather and put its token here.
TELEGRAM_BOT_TOKEN=
# Your chat id: send any message to the bot, then run: python -m app.cli telegram-whoami
TELEGRAM_OWNER_CHAT_ID=
# Time zone and local time (HH:MM) of the daily digest
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_TIME=09:00
# Postgres password for docker-compose (db service)
POSTGRES_PASSWORD=aichat
# Postgres port on the host (if 5432 is taken)
DB_HOST_PORT=5432
